# Copy to .env (git-ignored) and fill in. Never commit real values.

# development | staging | production
APP_ENV=development

# PostgreSQL. The application role must not have BYPASSRLS.
DATABASE_URL=postgresql+psycopg://wi_app:CHANGE_ME@localhost:5432/wealth_intelligence

# Redis broker for background jobs
REDIS_URL=redis://localhost:6379/0

# Authentication (ADR 0002): OIDC issuer and audience the API verifies tokens against
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWT_SECRET=

# AI layer (phase 13). Leave empty to disable AI explanations.
ANTHROPIC_API_KEY=

# Encryption key id for restricted columns and documents (from the secret manager)
DATA_ENCRYPTION_KEY_ID=
